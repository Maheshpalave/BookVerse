@model BookVerse.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>✏️ Edit Book</h1>
        <p class="lead">Update the book details below</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Book Title</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label">Author</label>
                    <input asp-for="Author" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Category</label>
                    <input asp-for="Category" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Rating" class="form-label">Rating</label>
                    <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
                </div>

                <div class="mb-3">
                    <label asp-for="CoverImage" class="form-label">Cover Image</label>
                    <input asp-for="CoverImage" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">
                    💾 Update Book
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    ← Back to Books
                </a>

            </form>

        </div>
    </div>
</div>