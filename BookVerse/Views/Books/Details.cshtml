@model BookVerse.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>📖 Book Details</h1>
        <p class="lead">Explore complete information about this book</p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <!-- Cover Image -->
                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.CoverImage))
                    {
                        <img src="~/images/@Model.CoverImage"
                             class="img-fluid rounded shadow-sm"
                             style="max-height:400px;"
                             alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="border rounded p-5">
                            📚
                            <p class="mt-2">No Cover Image</p>
                        </div>
                    }

                </div>

                <!-- Book Information -->
                <div class="col-md-8">

                    <h1 class="mb-4">
                        @Model.Title
                    </h1>

                    <p>
                        <strong>Author:</strong>
                        @Model.Author
                    </p>

                    <p>
                        <strong>Category:</strong>
                        @Model.Category
                    </p>

                    <p>
                        <strong>Rating:</strong>
                        ⭐ @Model.Rating / 5
                    </p>

                    <hr />

                    <h4>Description</h4>

                    <p>
                        @Model.Description
                    </p>

                    <div class="mt-4">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            ✏️ Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-danger">
                            🗑️ Delete
                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            ← Back to Books
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>