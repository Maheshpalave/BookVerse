@model IEnumerable<BookVerse.Models.Book>

@{
    ViewData["Title"] = "Category Books";
}

<div class="container mt-5">

    <div class="text-center mb-4">

        <h1>📚 @ViewBag.CategoryName Books</h1>

        <p class="lead">
            Books available in this category
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            📚 No books found in this category.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var book in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4 class="card-title">
                                @book.Title
                            </h4>

                            <p class="card-text">
                                <strong>Author:</strong>
                                @book.Author
                            </p>

                            <p class="card-text">
                                <strong>Category:</strong>
                                @book.Category
                            </p>

                            <p class="card-text">
                                <strong>Rating:</strong>
                                ⭐ @book.Rating
                            </p>

                            <a asp-controller="Books"
                               asp-action="Details"
                               asp-route-id="@book.Id"
                               class="btn btn-primary">
                                📖 Read Now
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="text-center mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back to Categories
        </a>

    </div>

</div>