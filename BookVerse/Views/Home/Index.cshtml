@{
    ViewData["Title"] = "Home";
}

<div class="container text-center mt-5">

    <h1 class="display-3 fw-bold">
        📚 BookVerse
    </h1>

    <p class="lead mt-3">
        Read Thousands of Books Anytime, Anywhere
    </p>

    <p>
        Discover, Read and Publish Books on One Platform.
    </p>

    <div class="mt-4">
        <button class="btn btn-primary btn-lg">
            Read Books
        </button>

        <button class="btn btn-success btn-lg ms-2">
            Become Author
        </button>
    </div>

</div>
<hr class="my-5" />

<div class="container">

    <h2 class="text-center mb-4">📚 Featured Books</h2>

    <div class="row">

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Atomic Habits</h5>
                    <p class="card-text">By James Clear</p>
                    <p>⭐⭐⭐⭐⭐</p>
                    <button class="btn btn-primary">Read Now</button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Rich Dad Poor Dad</h5>
                    <p class="card-text">By Robert Kiyosaki</p>
                    <p>⭐⭐⭐⭐⭐</p>
                    <button class="btn btn-primary">Read Now</button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Wings of Fire</h5>
                    <p class="card-text">By A.P.J. Abdul Kalam</p>
                    <p>⭐⭐⭐⭐⭐</p>
                    <button class="btn btn-primary">Read Now</button>
                </div>
            </div>
        </div>

    </div>

</div>