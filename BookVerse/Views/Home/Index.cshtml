@model IEnumerable<BookVerse.Models.Book>

@{
    ViewData["Title"] = "Home";
}

<div class="container text-center mt-5">

    <h1 class="display-3 fw-bold">
        📚 BookVerse
    </h1>

    <p class="lead mt-3">
        Read Thousands of Books Anytime, Anywhere
    </p>

    <p>
        Discover, Read and Publish Books on One Platform.
    </p>

    <div class="mt-4">

        <a asp-controller="Books"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            📚 Read Books
        </a>

        <a asp-controller="Register"
           asp-action="Index"
           class="btn btn-success btn-lg ms-2">
            ✍️ Become Author
        </a>

    </div>

</div>

<hr class="my-5" />

<div class="container">

    <h2 class="text-center mb-4">
        📚 Featured Books
    </h2>

    <div class="row">

        @foreach (var book in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(book.CoverImage))
                    {
                        <img src="~/images/@book.CoverImage"
                             class="card-img-top"
                             style="height:250px; object-fit:cover;"
                             alt="@book.Title" />
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @book.Title
                        </h5>

                        <p class="card-text">
                            <strong>Author:</strong> @book.Author
                        </p>

                        <p>
                            ⭐ @book.Rating
                        </p>

                        <a asp-controller="Books"
                           asp-action="Details"
                           asp-route-id="@book.Id"
                           class="btn btn-primary">
                            📖 Read Now
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>