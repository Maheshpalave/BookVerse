@model BookVerse.Models.Book

@{
    ViewData["Title"] = "Add Book";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>➕ Add New Book</h1>
        <p class="lead">Enter the book details below</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm">
                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">
                                Book Title
                            </label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Enter book title" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Author" class="form-label">
                                Author
                            </label>
                            <input asp-for="Author"
                                   class="form-control"
                                   placeholder="Enter author name" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label">
                                Category
                            </label>
                            <input asp-for="Category"
                                   class="form-control"
                                   placeholder="Enter category" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter book description"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">
                                Rating
                            </label>
                            <input asp-for="Rating"
                                   class="form-control"
                                   type="number"
                                   step="0.1"
                                   min="0"
                                   max="5"
                                   placeholder="Enter rating (0-5)" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CoverImage" class="form-label">
                                Cover Image
                            </label>
                            <input asp-for="CoverImage"
                                   class="form-control"
                                   placeholder="Enter image name or URL" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                💾 Save Book
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                ← Back to Books
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>